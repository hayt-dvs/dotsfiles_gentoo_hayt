configuration {
    modi: "drun";
    show-icons: true;
    drun-display-format: "{name}";
    font: "JetBrainsMono Nerd Font 12";
}

* {
    background: #1e1e2e;
    background-color: #1e1e2e;

    foreground: #cdd6f4;
    text-color: #cdd6f4;

    normal-background: #1e1e2e;
    normal-foreground: #cdd6f4;

    alternate-background: #1e1e2e;
    alternate-foreground: #cdd6f4;

    active-background: #1e1e2e;
    active-foreground: #cdd6f4;

    selected-background: #45475a;
    selected-foreground: #cdd6f4;

    urgent-background: #1e1e2e;
    urgent-foreground: #cdd6f4;
}

window {
    width: 650px;
    background-color: #1e1e2e;

    border: 2px;
    border-color: #cba6f7;
    border-radius: 16px;

    padding: 18px;
}

mainbox {
    background-color: #1e1e2e;
    children: [ inputbar, listview ];
    spacing: 12px;
}

inputbar {
    background-color: #181825;

    border: 1px;
    border-color: #313244;
    border-radius: 10px;

    padding: 12px 16px;

    children: [ prompt, entry ];
    spacing: 12px;
}

prompt {
    background-color: #181825;
    text-color: #cdd6f4;

    padding: 0px;
    margin: 0px;
    enabled: false;
}

entry {
    background-color: #181825;
    text-color: #cdd6f4;
}

listview {
    background-color: #1e1e2e;

    border: 0px;

    spacing: 4px;
    lines: 8;
    columns: 1;

    scrollbar: false;
}

element {
    background-color: #1e1e2e;
    text-color: #cdd6f4;

    border: 0px;
    border-radius: 10px;

    padding: 10px;

    children: [ element-icon, element-text ];
}

/* NORMAL */

element normal.normal {
    background-color: #1e1e2e;
    text-color: #cdd6f4;
}

element normal.urgent {
    background-color: #1e1e2e;
    text-color: #cdd6f4;
}

element normal.active {
    background-color: #1e1e2e;
    text-color: #cdd6f4;
}

/* ALTERNATE */

element alternate.normal {
    background-color: #1e1e2e;
    text-color: #cdd6f4;
}

element alternate.urgent {
    background-color: #1e1e2e;
    text-color: #cdd6f4;
}

element alternate.active {
    background-color: #1e1e2e;
    text-color: #cdd6f4;
}

/* SELECTED */

element selected.normal {
    background-color: #45475a;
    text-color: #cdd6f4;

    border: 1px;
    border-color: #cba6f7;
}

element selected.urgent {
    background-color: #45475a;
    text-color: #cdd6f4;
}

element selected.active {
    background-color: #45475a;
    text-color: #cdd6f4;
}

/* TEXT */

element-text {
    background-color: transparent;
    text-color: #cdd6f4;
}

element-icon {
    background-color: transparent;
    size: 30px;
    margin: 0px 14px 0px 0px;
}
